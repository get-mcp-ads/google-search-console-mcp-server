{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.getmcpads/google-search-console",
  "title": "Google Search Console",
  "description": "Google Search Console MCP server: 20 read tools, no write tools.",
  "version": "2.1.0",
  "websiteUrl": "https://www.getmcpads.com/tools/search-console",
  "repository": {
    "url": "https://github.com/get-mcp-ads/google-search-console-mcp-server",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@getmcpads/google-search-console-mcp-server",
      "version": "2.1.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "GSC_CLIENT_ID",
          "description": "OAuth client ID.",
          "isRequired": false,
          "isSecret": false
        },
        {
          "name": "GSC_CLIENT_SECRET",
          "description": "OAuth client secret.",
          "isRequired": false,
          "isSecret": true
        },
        {
          "name": "GSC_REFRESH_TOKEN",
          "description": "OAuth refresh token, webmasters.readonly scope.",
          "isRequired": false,
          "isSecret": true
        },
        {
          "name": "GSC_ACCESS_TOKEN",
          "description": "Short-lived access token, alternative to the three values above.",
          "isRequired": false,
          "isSecret": true
        },
        {
          "name": "GSC_SITE_URL",
          "description": "Default property, https://example.com/ or sc-domain:example.com.",
          "isRequired": false,
          "isSecret": false
        },
        {
          "name": "GSC_SITE_URLS",
          "description": "Comma-separated Search Console properties every tool is limited to. Optional in 2.x, required in 3.0.0.",
          "isRequired": false,
          "isSecret": false
        }
      ]
    }
  ]
}
